# /home/opc/.gs-records.env — chmod 600. Every value optional; a missing one
# makes its feature inert and the health endpoint says which.
GSR_PORT=8890
GSR_BIND=127.0.0.1
GSR_PUBLIC_URL=https://records.ninja-portal.com
GSR_DATA_DIR=/var/oled/gs-records
GSR_ADMIN_TOKEN=
GSR_NPC_NAME=Vesper
GSR_OPERATOR_EMAIL=

# prices, cents
GSR_PRICE_EP_CENTS=1900
GSR_PRICE_ALBUM_CENTS=3900
GSR_PRICE_DOUBLE_CENTS=6900

# money (inert until both are set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# the generator (the worker exits without it)
SUNO_API_KEY=
SUNO_MODEL=V4_5PLUS

# the hosted brain (template lyrics and titles without it)
BRAIN_API_KEY=
BRAIN_MODEL=kannaka-brain-7b-v1

# cover art via the Pixel Atelier (placeholder covers without it)
OPENBOTCITY_JWT=

# the tower floor (webhook 503 until the secret is set; no NPC in the room without the token)
KAX_AGENT_TOKEN=
KAX_TOWER_STOREY=
TOWER_WEBHOOK_SECRET=

# mail from Kannaka's own address (delivery mail skipped without it)
KANNAKA_MAIL_USER=kannaka@spacechild.love
KANNAKA_MAIL_PASS=
