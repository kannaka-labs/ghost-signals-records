# /home/opc/.gs-records.env — chmod 600. Every value optional; a missing one
# makes its feature inert and the health endpoint says which.
GSR_PORT=8890
GSR_BIND=127.0.0.1
GSR_PUBLIC_URL=https://records.ninja-portal.com
GSR_DATA_DIR=/var/oled/gs-records
GSR_ADMIN_TOKEN=
GSR_NPC_NAME=Vesper
GSR_OPERATOR_EMAIL=

# prices, cents
GSR_PRICE_EP_CENTS=1900
GSR_PRICE_ALBUM_CENTS=3900
GSR_PRICE_DOUBLE_CENTS=6900

# money (inert until both are set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# the generator (the worker exits without it)
SUNO_API_KEY=
SUNO_MODEL=V4_5PLUS

# the hosted brain (template lyrics and titles without it)
BRAIN_API_KEY=
BRAIN_MODEL=kannaka-brain-7b-v1

# cover art via the Pixel Atelier (placeholder covers without it)
OPENBOTCITY_JWT=

# the tower floor. KAX_TOWER_CREDENTIAL (twr_…, minted by the operator, pinned to
# one floor) writes the wall and registers the webhook. KAX_AGENT_TOKEN is the
# studio's bot in the city and is the ONLY thing that can speak in the room.
# TOWER_WEBHOOK_SECRET comes back once from the webhook registration.
KAX_TOWER_STOREY=
KAX_TOWER_CREDENTIAL=
KAX_AGENT_TOKEN=
TOWER_WEBHOOK_SECRET=

# mail from Kannaka's own address (delivery mail skipped without it)
KANNAKA_MAIL_USER=kannaka@spacechild.love
KANNAKA_MAIL_PASS=

# the free door: albums on the house while the generator has credit.
# auto (default) = free only while Stripe is unconfigured; on = free alongside
# payments; off = shut. The caps below are what stop one visitor, or one loud
# day, from spending the generator's balance.
# GSR_FREE_MODE=auto
# GSR_FREE_DAILY_LIMIT=3
# GSR_FREE_VISITOR_LIMIT=1
# GSR_FREE_MAX_TIER=album
# GSR_FREE_MIN_CREDITS=100
# GSR_CREDITS_PER_TRACK=10
# GSR_FREE_WINDOW_HOURS=24

# --- knobs config.js reads that have working defaults. Shown at their default
# --- value so a deploy can see them; uncomment only to change one.
# GSR_CURRENCY=usd
# GSR_MAIL_FROM=Ghost Signals Records <kannaka@spacechild.love>
# KANNAKA_MAIL_HOST=smtp.zoho.com
# KANNAKA_MAIL_PORT=465
# KAX_API_BASE=https://kax.ninja-portal.com/api
# BRAIN_BASE_URL=https://ninja-portal.com/v1
# BRAIN_TIMEOUT_MS=120000
# SUNO_API_BASE=https://api.sunoapi.org
# OBC_ART_STUDIO_ID=4fae4e5c-0e04-4734-83ee-69e0592f6e7d
# OBC_ART_GAP_MS=95000
# The generator refuses a request with no callback URL. This service answers at
# /api/suno/callback and drops what arrives, polling for the result instead.
# SUNO_CALLBACK_URL=https://records.ninja-portal.com/api/suno/callback
